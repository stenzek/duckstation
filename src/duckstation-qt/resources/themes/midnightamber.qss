 * dark: dark
 * window: #111829
 * window-text: #eef1f7
 * base: #0a0f1c
 * alternate-base: #10172a
 * tooltip-base: #111829
 * tooltip-text: #eef1f7
 * text: #eef1f7
 * button: #141b2d
 * button-text: #eef1f7
 * link: #ffd27a
 * highlight: #34406a
 * highlight-text: #eef1f7
 * placeholder-text: #6f7891
 * active-button: #141b2d
 * disabled-button-text: #6f7891
 * disabled-window-text: #6f7891
 * disabled-text: #6f7891
 * disabled-light: #111829
 */QMenu{border:1px solid #2a3452;border-radius:8px;padding:6px 10px;background-color:#0e1424}QMenu::icon,QMenu::indicator{left:8px}QMenu::item{padding:6px 18px;border-radius:8px}QMenu::item:selected{background-color:#34406a;color:#eef1f7}QMenu::icon:checked{background:#34406a;border:1px solid #6f7891;border-radius:4px}QMenu::separator{height:1px;background:#2a3452;margin:4px 8px}QMenuBar::item{padding:4px 6px;border-radius:6px}QMenuBar::item:selected,QMenuBar::item:pressed{background:#34406a;color:#eef1f7;border-radius:4px}QToolTip{color:#eef1f7;background-color:#0e1424;border:1px solid #2a3452;border-radius:6px;padding:2px}QToolBar{border:none}QToolButton{border:none;background:rgba(0,0,0,0);padding:3px;border-radius:8px}QToolButton:checked{background-color:#1a2238}QToolButton:hover{background-color:#34406a;color:#eef1f7}QToolButton:pressed{background-color:#3d4b7a;color:#eef1f7}QPushButton{border:none;background-color:#1a2238;padding:5px 10px;border-radius:8px;color:#eef1f7}QPushButton:checked{background-color:#34406a;color:#eef1f7}QPushButton:hover{background-color:#2a3452}QPushButton:pressed{background-color:#3d4b7a;color:#eef1f7}QPushButton:disabled{background-color:#141b2d;color:#6f7891}QDialog QPushButton{min-width:50px;padding:6px 12px}.pill-label{background-color:#1a2238;border-radius:8px;padding:5px 10px;color:#eef1f7}QLineEdit{border:1px solid rgba(0,0,0,0);border-radius:8px;padding:3px 7px;background-color:#141b2d;selection-background-color:#34406a;selection-color:#eef1f7;color:#eef1f7}QPlainTextEdit{border:1px solid rgba(0,0,0,0);border-radius:8px;padding:2px 5px;background-color:#141b2d;selection-background-color:#34406a;selection-color:#eef1f7;color:#eef1f7}QLineEdit::hover{background-color:#27314e}QLineEdit:disabled,QPlainTextEdit:disabled{background-color:#0c1220;color:#6f7891}QCheckBox{spacing:4px;padding:2px 0}.bold-groups QGroupBox,.bold-title{font-weight:700}QGroupBox::title{padding-bottom:2px}QCheckBox::indicator{width:14px;height:14px}QCheckBox::indicator::unchecked{image:url(":/icons/white/svg/checkbox-unchecked.svg")}QCheckBox::indicator::unchecked:pressed{image:url(":/icons/white/svg/checkbox-unchecked-pressed.svg")}QCheckBox::indicator::unchecked:disabled{image:url(":/icons/white/svg/checkbox-unchecked-disabled.svg")}QCheckBox::indicator::checked{image:url(":/icons/white/svg/checkbox-checked.svg")}QCheckBox::indicator::checked:pressed{image:url(":/icons/white/svg/checkbox-checked-pressed.svg")}QCheckBox::indicator::checked:disabled{image:url(":/icons/white/svg/checkbox-checked-disabled.svg")}QCheckBox::indicator::indeterminate{image:url(":/icons/white/svg/checkbox-indeterminate.svg")}QCheckBox::indicator::indeterminate:pressed{image:url(":/icons/white/svg/checkbox-indeterminate-pressed.svg")}QCheckBox::indicator::indeterminate:disabled{image:url(":/icons/white/svg/checkbox-indeterminate-disabled.svg")}QAbstractSpinBox{border:1px solid rgba(0,0,0,0);border-radius:8px;padding:2px 7px;background-color:#141b2d;selection-background-color:#34406a;selection-color:#eef1f7;color:#eef1f7}QAbstractSpinBox::hover{background-color:#27314e}QAbstractSpinBox:disabled{background-color:#0c1220;color:#6f7891}QAbstractSpinBox::up-button,QAbstractSpinBox::down-button{subcontrol-origin:border;width:8px;border:none;padding:0 8px}QAbstractSpinBox::up-button{subcontrol-position:top right}QAbstractSpinBox::up-arrow{width:8px;height:8px;image:url(":/icons/white/svg/arrow-up.svg")}QAbstractSpinBox::up-arrow:disabled{image:url(":/icons/white/svg/arrow-up-disabled.svg")}QAbstractSpinBox::down-button{subcontrol-position:bottom right}QAbstractSpinBox::down-arrow{width:8px;height:8px;image:url(":/icons/white/svg/arrow-down.svg")}QAbstractSpinBox::down-arrow:disabled{image:url(":/icons/white/svg/arrow-down-disabled.svg")}QComboBox{border:1px solid rgba(0,0,0,0);border-radius:8px;padding:3px 9px 3px 7px;background-color:#141b2d;color:#eef1f7;selection-background-color:#34406a;selection-color:#eef1f7}QComboBox:hover{background-color:#27314e}QLineEdit:focus,QPlainTextEdit:focus,QAbstractSpinBox:focus,QComboBox:focus{border-color:#f2b33d}QCheckBox,QRadioButton,QPushButton{selection-background-color:#f2b33d}QComboBox:disabled{background-color:#0c1220;color:#6f7891}QComboBox::drop-down{subcontrol-origin:padding;subcontrol-position:top right;width:16px;border:none;padding:0 6px;background:rgba(0,0,0,0)}QComboBox::down-arrow{width:10px;height:10px;image:url(":/icons/white/svg/arrow-down.svg")}QComboBox::down-arrow:disabled{image:url(":/icons/white/svg/arrow-down-disabled.svg")}QScrollBar{background:#141b2d;width:12px;margin:0px;border-radius:6px}QScrollBar::handle{background-color:#34406a;min-height:20px;border-radius:6px}QScrollBar::handle:hover{background:#3d4b7a}QScrollBar::add-line:vertical,QScrollBar::sub-line:vertical,QScrollBar::add-line:horizontal,QScrollBar::sub-line:horizontal{height:0}QHeaderView{background-color:#141b2d}QHeaderView::section{background-color:#1a2238;padding:2px 4px;color:#eef1f7;border:none}QHeaderView::section:middle,QHeaderView::section:last{border-left:1px solid #1c2540}QHeaderView::section:hover{background-color:#34406a;color:#eef1f7}QHeaderView::section:pressed{background-color:#3d4b7a}QTabBar{qproperty-drawBase:false}QTabBar::tab{background:#1a2238;padding:6px 12px;border-top-left-radius:8px;border-top-right-radius:8px;border-right:1px solid rgba(0,0,0,0);color:#eef1f7}QTabBar::tab:bottom{border-top-left-radius:0;border-top-right-radius:0;border-bottom-left-radius:8px;border-bottom-right-radius:8px}QTabBar::tab:selected{background:#34406a;color:#eef1f7}QTabBar::tab:hover{background:#27314e;color:#eef1f7}QTabBar::tab:top{border-bottom:2px solid rgba(0,0,0,0);padding-bottom:4px}QTabBar::tab:bottom{border-top:2px solid rgba(0,0,0,0);padding-top:4px}QTabBar::tab:top:selected{border-bottom:2px solid #f2b33d}QTabBar::tab:bottom:selected{border-top:2px solid #f2b33d}QProgressBar{border:none;border-radius:8px;background-color:#141b2d;color:#eef1f7;text-align:center}QProgressBar::chunk{background-color:#a37829;border-radius:8px}QSlider{margin:2px 0}QSlider::groove{border:none;height:8px;background-color:rgb(52.7,59.1,75.3);border-radius:4px}QSlider::sub-page:horizontal{background-color:#f2b33d;border-radius:4px}QSlider::sub-page:horizontal:disabled{background-color:#0c1220}QSlider::handle{background-color:#f2b33d;border:none;width:16px;margin:-4px 0;border-radius:8px}QSlider::handle:hover{background-color:#ffd27a}QSlider::handle:pressed{background-color:#d99a28}QSlider::groove:disabled{background-color:#0c1220}QSlider::handle:disabled{background-color:#6f7891}QTextBrowser{border:none;border-radius:8px;padding:2px 4px;background-color:#141b2d;selection-background-color:#34406a;selection-color:#eef1f7;color:#eef1f7}.settings-window QListView{border:none;border-radius:8px;background-color:#141b2d;color:#eef1f7;selection-background-color:#34406a;selection-color:#eef1f7;padding:4px}.settings-window QListView::item{border:none;padding:2px 4px;border-radius:8px}.settings-window QListView::item:hover{background-color:#27314e}.settings-window QListView::item:selected{background-color:#34406a;color:#eef1f7}.settings-window QListView:focus,.settings-window QListView::item:focus,.settings-window QListView::item:selected:focus{outline:none;border:none}.settings-window QTreeView{border:none;border-radius:8px;background-color:#141b2d;color:#eef1f7;selection-background-color:#34406a;selection-color:#eef1f7;padding:4px}.settings-window QTreeView::item{border:none;padding:2px 4px}.settings-window QTreeView::item:first{border-top-left-radius:8px;border-bottom-left-radius:8px}.settings-window QTreeView::item:last{border-top-right-radius:8px;border-bottom-right-radius:8px}.settings-window QTreeView::item:hover{background-color:#27314e}.settings-window QTreeView::item:selected{background-color:#34406a;color:#eef1f7}.settings-window GamePatchSettingsWidget QScrollArea,.settings-window GamePatchSettingsWidget #patches_container{border:none;border-radius:8px;background:#141b2d}.settings-window GamePatchSettingsWidget #patches_container>QFrame{border:none;border-bottom:1px solid #34406a;margin:0px 8px}.settings-window GameCheatSettingsWidget QTreeView::item:first,.settings-window GameCheatSettingsWidget QTreeView::item:last{border-radius:0}
