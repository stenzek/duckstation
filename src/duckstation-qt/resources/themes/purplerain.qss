 * disabled-text: #8a70b8
 * disabled-light: #492979
 */QMenu{border:1px solid #4a3070;border-radius:8px;padding:6px 10px;background-color:#301e4a}QMenu::icon,QMenu::indicator{left:8px}QMenu::item{padding:6px 18px;border-radius:8px}QMenu::item:selected{background-color:#6a42a8;color:#fff}QMenu::icon:checked{background:#6a42a8;border:1px solid #8a70b8;border-radius:4px}QMenu::separator{height:1px;background:#4a3070;margin:4px 8px}QMenuBar::item{padding:4px 6px;border-radius:6px}QMenuBar::item:selected,QMenuBar::item:pressed{background:#6a42a8;color:#fff;border-radius:4px}QToolTip{color:#fff;background-color:#301e4a;border:1px solid #4a3070;border-radius:6px;padding:2px}QToolBar{border:none}QToolButton{border:none;background:rgba(0,0,0,0);padding:3px;border-radius:8px}QToolButton:checked{background-color:#402868}QToolButton:hover{background-color:#6a42a8;color:#fff}QToolButton:pressed{background-color:#7a52bc;color:#fff}QPushButton{border:none;background-color:#402868;padding:5px 10px;border-radius:8px;color:#fff}QPushButton:checked{background-color:#6a42a8;color:#fff}QPushButton:hover{background-color:#583a80}QPushButton:pressed{background-color:#7a52bc;color:#fff}QPushButton:disabled{background-color:#3a2360;color:#8a70b8}QDialog QPushButton{min-width:50px;padding:6px 12px}.pill-label{background-color:#402868;border-radius:8px;padding:5px 10px;color:#fff}QLineEdit{border:1px solid rgba(0,0,0,0);border-radius:8px;padding:3px 7px;background-color:#3a2360;selection-background-color:#6a42a8;selection-color:#fff;color:#fff}QPlainTextEdit{border:1px solid rgba(0,0,0,0);border-radius:8px;padding:2px 5px;background-color:#3a2360;selection-background-color:#6a42a8;selection-color:#fff;color:#fff}QLineEdit::hover{background-color:#503278}QLineEdit:disabled,QPlainTextEdit:disabled{background-color:#2a1840;color:#8a70b8}QCheckBox{spacing:4px;padding:2px 0}.bold-groups QGroupBox,.bold-title{font-weight:700}QGroupBox::title{padding-bottom:2px}QCheckBox::indicator{width:14px;height:14px}QCheckBox::indicator::unchecked{image:url(":/icons/white/svg/checkbox-unchecked.svg")}QCheckBox::indicator::unchecked:pressed{image:url(":/icons/white/svg/checkbox-unchecked-pressed.svg")}QCheckBox::indicator::unchecked:disabled{image:url(":/icons/white/svg/checkbox-unchecked-disabled.svg")}QCheckBox::indicator::checked{image:url(":/icons/white/svg/checkbox-checked.svg")}QCheckBox::indicator::checked:pressed{image:url(":/icons/white/svg/checkbox-checked-pressed.svg")}QCheckBox::indicator::checked:disabled{image:url(":/icons/white/svg/checkbox-checked-disabled.svg")}QCheckBox::indicator::indeterminate{image:url(":/icons/white/svg/checkbox-indeterminate.svg")}QCheckBox::indicator::indeterminate:pressed{image:url(":/icons/white/svg/checkbox-indeterminate-pressed.svg")}QCheckBox::indicator::indeterminate:disabled{image:url(":/icons/white/svg/checkbox-indeterminate-disabled.svg")}QAbstractSpinBox{border:1px solid rgba(0,0,0,0);border-radius:8px;padding:2px 7px;background-color:#3a2360;selection-background-color:#6a42a8;selection-color:#fff;color:#fff}QAbstractSpinBox::hover{background-color:#503278}QAbstractSpinBox:disabled{background-color:#2a1840;color:#8a70b8}QAbstractSpinBox::up-button,QAbstractSpinBox::down-button{subcontrol-origin:border;width:8px;border:none;padding:0 8px}QAbstractSpinBox::up-button{subcontrol-position:top right}QAbstractSpinBox::up-arrow{width:8px;height:8px;image:url(":/icons/white/svg/arrow-up.svg")}QAbstractSpinBox::up-arrow:disabled{image:url(":/icons/white/svg/arrow-up-disabled.svg")}QAbstractSpinBox::down-button{subcontrol-position:bottom right}QAbstractSpinBox::down-arrow{width:8px;height:8px;image:url(":/icons/white/svg/arrow-down.svg")}QAbstractSpinBox::down-arrow:disabled{image:url(":/icons/white/svg/arrow-down-disabled.svg")}QComboBox{border:1px solid rgba(0,0,0,0);border-radius:8px;padding:3px 9px 3px 7px;background-color:#3a2360;color:#fff;selection-background-color:#6a42a8;selection-color:#fff}QComboBox:hover{background-color:#503278}QLineEdit:focus,QPlainTextEdit:focus,QAbstractSpinBox:focus,QComboBox:focus{border-color:#facf00}QCheckBox,QRadioButton,QPushButton{selection-background-color:#facf00}QComboBox:disabled{background-color:#2a1840;color:#8a70b8}QComboBox::drop-down{subcontrol-origin:padding;subcontrol-position:top right;width:16px;border:none;padding:0 6px;background:rgba(0,0,0,0)}QComboBox::down-arrow{width:10px;height:10px;image:url(":/icons/white/svg/arrow-down.svg")}QComboBox::down-arrow:disabled{image:url(":/icons/white/svg/arrow-down-disabled.svg")}QScrollBar{background:#3a2360;width:12px;margin:0px;border-radius:6px}QScrollBar::handle{background-color:#6a42a8;min-height:20px;border-radius:6px}QScrollBar::handle:hover{background:#7a52bc}QScrollBar::add-line:vertical,QScrollBar::sub-line:vertical,QScrollBar::add-line:horizontal,QScrollBar::sub-line:horizontal{height:0}QHeaderView{background-color:#3a2360}QHeaderView::section{background-color:#402868;padding:2px 4px;color:#fff;border:none}QHeaderView::section:middle,QHeaderView::section:last{border-left:1px solid #402860}QHeaderView::section:hover{background-color:#6a42a8;color:#fff}QHeaderView::section:pressed{background-color:#7a52bc}QTabBar{qproperty-drawBase:false}QTabBar::tab{background:#402868;padding:6px 12px;border-top-left-radius:8px;border-top-right-radius:8px;border-right:1px solid rgba(0,0,0,0);color:#fff}QTabBar::tab:bottom{border-top-left-radius:0;border-top-right-radius:0;border-bottom-left-radius:8px;border-bottom-right-radius:8px}QTabBar::tab:selected{background:#6a42a8;color:#fff}QTabBar::tab:hover{background:#503278;color:#fff}QTabBar::tab:top{border-bottom:2px solid rgba(0,0,0,0);padding-bottom:4px}QTabBar::tab:bottom{border-top:2px solid rgba(0,0,0,0);padding-top:4px}QTabBar::tab:top:selected{border-bottom:2px solid #facf00}QTabBar::tab:bottom:selected{border-top:2px solid #facf00}QProgressBar{border:none;border-radius:8px;background-color:#3a2360;color:#fff;text-align:center}QProgressBar::chunk{background-color:#a86f00;border-radius:8px}QSlider{margin:2px 0}QSlider::groove{border:none;height:8px;background-color:rgb(87.55,68,119.85);border-radius:4px}QSlider::sub-page:horizontal{background-color:#facf00;border-radius:4px}QSlider::sub-page:horizontal:disabled{background-color:#2a1840}QSlider::handle{background-color:#facf00;border:none;width:16px;margin:-4px 0;border-radius:8px}QSlider::handle:hover{background-color:#ffe030}QSlider::handle:pressed{background-color:#d4b000}QSlider::groove:disabled{background-color:#2a1840}QSlider::handle:disabled{background-color:#8a70b8}QTextBrowser{border:none;border-radius:8px;padding:2px 4px;background-color:#3a2360;selection-background-color:#6a42a8;selection-color:#fff;color:#fff}.settings-window QListView{border:none;border-radius:8px;background-color:#3a2360;color:#fff;selection-background-color:#6a42a8;selection-color:#fff;padding:4px}.settings-window QListView::item{border:none;padding:2px 4px;border-radius:8px}.settings-window QListView::item:hover{background-color:#503278}.settings-window QListView::item:selected{background-color:#6a42a8;color:#fff}.settings-window QListView:focus,.settings-window QListView::item:focus,.settings-window QListView::item:selected:focus{outline:none;border:none}.settings-window QTreeView{border:none;border-radius:8px;background-color:#3a2360;color:#fff;selection-background-color:#6a42a8;selection-color:#fff;padding:4px}.settings-window QTreeView::item{border:none;padding:2px 4px}.settings-window QTreeView::item:first{border-top-left-radius:8px;border-bottom-left-radius:8px}.settings-window QTreeView::item:last{border-top-right-radius:8px;border-bottom-right-radius:8px}.settings-window QTreeView::item:hover{background-color:#503278}.settings-window QTreeView::item:selected{background-color:#6a42a8;color:#fff}.settings-window GamePatchSettingsWidget QScrollArea,.settings-window GamePatchSettingsWidget #patches_container{border:none;border-radius:8px;background:#3a2360}.settings-window GamePatchSettingsWidget #patches_container>QFrame{border:none;border-bottom:1px solid #6a42a8;margin:0px 8px}.settings-window GameCheatSettingsWidget QTreeView::item:first,.settings-window GameCheatSettingsWidget QTreeView::item:last{border-radius:0}
